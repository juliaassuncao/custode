# Public browser configuration only. Never add service_role or secret keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TURNSTILE_SITE_KEY=YOUR_PUBLIC_TURNSTILE_SITE_KEY

# Private SUPABASE_AUTH_CAPTCHA_SECRET belongs to the CLI/Auth environment only.
# TURNSTILE_SECRET_KEY belongs to the Edge runtime only (supabase/.env).
# See src/features/community/README.md. Never prefix a private key with VITE_.
