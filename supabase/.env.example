# Private local Auth configuration. Supply via the CLI process environment or
# copy this template to supabase/.env (ignored by Git). Never use a VITE_ prefix.
SUPABASE_AUTH_CAPTCHA_SECRET=YOUR_PRIVATE_TURNSTILE_SECRET_KEY
# Edge Function runtime (functions serve --env-file supabase/.env).
# Provision securely; SUPABASE_* custom variables are skipped by the Edge CLI.
TURNSTILE_SECRET_KEY=YOUR_PRIVATE_TURNSTILE_SECRET_KEY
